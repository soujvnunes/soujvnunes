{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ESLint Debug",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/.bin/eslint",
      "args": ["${file}", "--config", "${workspaceFolder}/eslint.config.mjs"],
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal"
    }
  ]
}
